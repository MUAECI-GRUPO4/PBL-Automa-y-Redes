   #Cursor := 0;
   #Etapa := 2;
END_IF;

// un datagrama por trozo: cabecera de 18 bytes + bloques enteros (id, longitud, datos)
IF #Etapa = 2 THEN
   #Bytes_trozo := 0;
   #Bloques_trozo := 0;
   #longitud := #Cursor;
   WHILE #Cursor < #Total DO
      #lon_bloque := BYTE_TO_DINT(#Foto[#Cursor + 2]) * 256 + BYTE_TO_DINT(#Foto[#Cursor + 3]) + 4;
      IF #Bytes_trozo + #lon_bloque > #MAX_PAYLOAD AND #Bloques_trozo > 0 THEN EXIT; END_IF;
      #Bytes_trozo := #Bytes_trozo + #lon_bloque;
      #Cursor := #Cursor + #lon_bloque;
      #Bloques_trozo := #Bloques_trozo + 1;
   END_WHILE;
   #Datagrama[0] := 16#50;
   #Datagrama[1] := 16#47;
   #Datagrama[2] := 2;
   #Datagrama[3] := USINT_TO_BYTE(#ID_PLC);
   #d := UDINT_TO_DWORD(#Secuencia);
   #Datagrama[4] := #d.%B3;
   #Datagrama[5] := #d.%B2;
   #Datagrama[6] := #d.%B1;
   #Datagrama[7] := #d.%B0;
   #l := LINT_TO_LWORD(#Marca_tiempo);
   #Datagrama[8] := #l.%B7;
   #Datagrama[9] := #l.%B6;
   #Datagrama[10] := #l.%B5;
   #Datagrama[11] := #l.%B4;
   #Datagrama[12] := #l.%B3;
   #Datagrama[13] := #l.%B2;
   #Datagrama[14] := #l.%B1;
   #Datagrama[15] := #l.%B0;
   #w := UINT_TO_WORD(#Bloques_trozo);
   #Datagrama[16] := #w.%B1;
   #Datagrama[17] := #w.%B0;
   #resultado := MOVE_BLK_VARIANT(SRC := #Foto, COUNT := DINT_TO_UDINT(#Bytes_trozo),
                                  SRC_INDEX := #longitud, DEST_INDEX := 18, DEST => #Datagrama);
   #Secuencia := #Secuencia + 1;
   #Lanza_envio := TRUE;
   #Etapa := 3;
END_IF;

#Cliente_envio(REQ := #Lanza_envio, ID := #Conexion.ID, LEN := DINT_TO_UDINT(#Bytes_trozo + 18),
               DATA := #Datagrama, ADDR := #Destino, STATUS => #Estado_tusend);
#Lanza_envio := FALSE;

// resultado del envio; si la conexion se perdio, a reconectar
#Espera_envio(IN := #Etapa = 3, PT := T#1s);
IF #Etapa = 3 THEN
   IF #Cliente_envio.DONE THEN
      #Enviados := #Enviados + 1;
      IF #Cursor >= #Total THEN #Etapa := 1; ELSE #Etapa := 2; END_IF;
   ELSIF #Cliente_envio.ERROR OR #Espera_envio.Q THEN
      #Fallidos := #Fallidos + 1;
      #Conectado := FALSE;
      #Etapa := 0;
   END_IF;
END_IF;

END_FUNCTION_BLOCK
