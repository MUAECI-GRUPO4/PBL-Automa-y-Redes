      lon_bloque : DInt;
   END_VAR
   VAR CONSTANT
      ID_PLC : USInt := 4;
      N_BLOQUES : Int := 274;
      MAX_PAYLOAD : DInt := 1380;
   END_VAR

BEGIN
// parametros: un valor a cero (DB sin valores iniciales) se sustituye por el de fabrica
#periodo_uso := #Periodo;
IF #periodo_uso <= T#0ms THEN #periodo_uso := T#100ms; END_IF;
#puerto_uso := #Puerto;
IF #puerto_uso = 0 THEN #puerto_uso := 5000; END_IF;

// conexion UDP: un TCON hasta que acabe bien, reintento cada segundo
#Conexion.InterfaceId := "Local~Interfaz_PROFINET_1";
#Conexion.ID := 16#0001;
#Conexion.ConnectionType := 16#13;
#Conexion.ActiveEstablished := FALSE;
#Conexion.RemoteAddress.ADDR := #Ip_pasarela;
#Conexion.RemotePort := #puerto_uso;
#Conexion.LocalPort := #puerto_uso;
FOR #i := 1 TO 4 DO
   #Destino.REM_IP_ADDR[#i] := #Ip_pasarela[#i];
END_FOR;
#Destino.REM_PORT_NR := #puerto_uso;
#Destino.RESERVED := 0;

#Espera_conexion(IN := NOT #Deshabilitar AND NOT #Conectado AND NOT #Cliente_con.BUSY, PT := T#1s);
#Lanza_conexion := #Espera_conexion.Q;
#Cliente_con(REQ := #Lanza_conexion, ID := #Conexion.ID, CONNECT := #Conexion, STATUS => #Estado_tcon);
#Flanco_conexion(CLK := #Lanza_conexion);
IF #Flanco_conexion.Q THEN #Intentos_tcon := #Intentos_tcon + 1; END_IF;
IF #Cliente_con.ERROR THEN
   #Ultimo_error_tcon := #Estado_tcon;
   #Errores_tcon := #Errores_tcon + 1;
END_IF;
IF #Cliente_con.DONE THEN
   IF NOT #Conectado THEN #Conexiones_ok := #Conexiones_ok + 1; END_IF;
   #Conectado := TRUE;
   IF #Etapa = 0 THEN #Etapa := 1; END_IF;
END_IF;
IF #Deshabilitar THEN
   #Conectado := FALSE;
   #Etapa := 0;
END_IF;

// foto de todos los miembros y marca de tiempo UTC (ms desde 1970) cada periodo
#Espera_periodo(IN := #Conectado AND #Etapa = 1, PT := #periodo_uso);
IF #Espera_periodo.Q THEN
   #resultado := RD_SYS_T(OUT => #reloj);
   #anio := UINT_TO_LINT(#reloj.YEAR);
   #mes := USINT_TO_LINT(#reloj.MONTH);
   #dia := USINT_TO_LINT(#reloj.DAY);
   IF #mes <= 2 THEN #anio := #anio - 1; END_IF;
   #era := #anio / 400;
   #ano_era := #anio - #era * 400;
   #dia_ano := (153 * ((#mes + 9) MOD 12) + 2) / 5 + #dia - 1;
   #dias := #era * 146097 + #ano_era * 365 + #ano_era / 4 - #ano_era / 100 + #dia_ano - 719468;
   #Marca_tiempo := ((#dias * 86400 + USINT_TO_LINT(#reloj.HOUR) * 3600 + USINT_TO_LINT(#reloj.MINUTE) * 60
                      + USINT_TO_LINT(#reloj.SECOND)) * 1000) + UDINT_TO_LINT(#reloj.NANOSECOND) / 1000000;
   #Total := 0;
   #Bloques_escritos := 0;
   #Copia_1 := "DB_App_out".Entradas_app;
   #Resultado := "FC_UDP_Bloque"(Id := 1, Origen := #Copia_1, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_2 := "DB_App_out".App_inicio;
   #Resultado := "FC_UDP_Bloque"(Id := 2, Origen := #Copia_2, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_3 := "DB_App_out".Emergencia;
   #Resultado := "FC_UDP_Bloque"(Id := 3, Origen := #Copia_3, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_4 := "DB_App_out".Rearme;
   #Resultado := "FC_UDP_Bloque"(Id := 4, Origen := #Copia_4, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_5 := "DB_App_out".Hora_actual;
   #Resultado := "FC_UDP_Bloque"(Id := 5, Origen := #Copia_5, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_6 := "DB_App_out".Hora_inicio_app;
   #Resultado := "FC_UDP_Bloque"(Id := 6, Origen := #Copia_6, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_7 := "DB_App_out".Registro_nuevo;
   #Resultado := "FC_UDP_Bloque"(Id := 7, Origen := #Copia_7, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_8 := "DB_App_out".Registro_palet;
   #Resultado := "FC_UDP_Bloque"(Id := 8, Origen := #Copia_8, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_9 := "DB_App_out".Out_hora_inicio;
   #Resultado := "FC_UDP_Bloque"(Id := 9, Origen := #Copia_9, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_10 := "DB_App_out".Out_hora_fin;
   #Resultado := "FC_UDP_Bloque"(Id := 10, Origen := #Copia_10, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_11 := "DB_App_out".App_rearme_requerido;
   #Resultado := "FC_UDP_Bloque"(Id := 11, Origen := #Copia_11, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_12 := "DB_App_out".App_en_reposo;
   #Resultado := "FC_UDP_Bloque"(Id := 12, Origen := #Copia_12, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_13 := "DB_App_out".App_terminada;
   #Resultado := "FC_UDP_Bloque"(Id := 13, Origen := #Copia_13, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_14 := "DB_App_out".App_alarma;
   #Resultado := "FC_UDP_Bloque"(Id := 14, Origen := #Copia_14, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_15 := "DB_App_out".Inhibir_cinta;
   #Resultado := "FC_UDP_Bloque"(Id := 15, Origen := #Copia_15, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_16 := "DB_App_out".Cond_conf;
   #Resultado := "FC_UDP_Bloque"(Id := 16, Origen := #Copia_16, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_17 := "DB_App_out".Cond_almacen;
   #Resultado := "FC_UDP_Bloque"(Id := 17, Origen := #Copia_17, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_18 := "DB_App_out".Etapa_app;
   #Resultado := "FC_UDP_Bloque"(Id := 18, Origen := #Copia_18, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_19 := "DB_App_out".Etapa_previa;
   #Resultado := "FC_UDP_Bloque"(Id := 19, Origen := #Copia_19, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_20 := "DB_App_out".Posicion_objetivo;
   #Resultado := "FC_UDP_Bloque"(Id := 20, Origen := #Copia_20, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_21 := "DB_App_out".Almacen_destino;
   #Resultado := "FC_UDP_Bloque"(Id := 21, Origen := #Copia_21, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_22 := "DB_App_out".Start_enviado;
   #Resultado := "FC_UDP_Bloque"(Id := 22, Origen := #Copia_22, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_23 := "DB_App_out".Pieza_en_garra;
   #Resultado := "FC_UDP_Bloque"(Id := 23, Origen := #Copia_23, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_24 := "DB_App_out".Parpadeo;
   #Resultado := "FC_UDP_Bloque"(Id := 24, Origen := #Copia_24, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_25 := "DB_App_out".Emergencia_previa;
   #Resultado := "FC_UDP_Bloque"(Id := 25, Origen := #Copia_25, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_26 := "DB_App_out".Recuperando;
   #Resultado := "FC_UDP_Bloque"(Id := 26, Origen := #Copia_26, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_27 := "DB_App_out".Registro_hecho;
   #Resultado := "FC_UDP_Bloque"(Id := 27, Origen := #Copia_27, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_28 := "DB_App_out".Calidad_final;
   #Resultado := "FC_UDP_Bloque"(Id := 28, Origen := #Copia_28, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_29 := "DB_App_out".Incompleta;
   #Resultado := "FC_UDP_Bloque"(Id := 29, Origen := #Copia_29, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_30 := "DB_App_out".Timer_arranque.IN;
   #Resultado := "FC_UDP_Bloque"(Id := 30, Origen := #Copia_30, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_31 := "DB_App_out".Timer_arranque.Q;
   #Resultado := "FC_UDP_Bloque"(Id := 31, Origen := #Copia_31, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_32 := "DB_App_out".Timer_arranque.PT;
   #Resultado := "FC_UDP_Bloque"(Id := 32, Origen := #Copia_32, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_33 := "DB_App_out".Timer_arranque.ET;
   #Resultado := "FC_UDP_Bloque"(Id := 33, Origen := #Copia_33, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_34 := "DB_App_out".Timer_conf.IN;
   #Resultado := "FC_UDP_Bloque"(Id := 34, Origen := #Copia_34, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_35 := "DB_App_out".Timer_conf.Q;
   #Resultado := "FC_UDP_Bloque"(Id := 35, Origen := #Copia_35, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_36 := "DB_App_out".Timer_conf.PT;
   #Resultado := "FC_UDP_Bloque"(Id := 36, Origen := #Copia_36, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_37 := "DB_App_out".Timer_conf.ET;
   #Resultado := "FC_UDP_Bloque"(Id := 37, Origen := #Copia_37, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
   #Copia_38 := "DB_App_out".Timer_almacen.IN;
   #Resultado := "FC_UDP_Bloque"(Id := 38, Origen := #Copia_38, Inicio := #Total, Foto := #Foto, Escritos := #Bloques_escritos, Final => #Total);
