# Plantilla de configuración. preparar.sh la copia a .env con contraseñas aleatorias.
# Las tres líneas con CAMBIAR no llevan nunca un valor real en este fichero.

# IP del equipo en la que se publican los puertos 8086 y 3000 (127.0.0.1: solo este equipo)
IP_PUBLICADA=127.0.0.1

INFLUX_USUARIO=gestor_influx
INFLUX_CLAVE=CAMBIAR
INFLUX_ORG=grupo4
INFLUX_BUCKET=planta
# Cuánto tiempo se conservan los datos
INFLUX_RETENCION=30d
INFLUX_TOKEN=CAMBIAR

# Distinto de "admin", como pide el enunciado
GRAFANA_USUARIO=gestor_grafana
GRAFANA_CLAVE=CAMBIAR
